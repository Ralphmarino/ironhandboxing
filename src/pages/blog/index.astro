---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getCollection } from 'astro:content';

// Title preserved from the WordPress site.
const title = 'Blog – Ironhand Boxing';
const description =
  'Boxing training, technique and gym news from Ironhand Boxing in Staten Island, written by Coach Ian Sampaga and the Ironhand coaching staff.';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const [featured, ...rest] = posts;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---

<Base title={title} description={description}>
  <section class="section blog-hero gridlines">
    <div class="wrap">
      <p class="eyebrow" data-reveal>The Blog</p>
      <h1 class="display steel blog-hero__h1" data-reveal data-reveal-index="1">
        Notes from<br />the corner.
      </h1>
      <p class="lede blog-hero__lede" data-reveal data-reveal-index="2">
        Training, technique and straight answers from the coaches at Ironhand.
      </p>
    </div>
  </section>

  <section class="section blog">
    <div class="wrap">
      {
        featured && (
          <a class="feat" href={`/blog/${featured.id}/`} data-reveal>
            <div class="feat__media">
              <img
                src={featured.data.image}
                alt={featured.data.imageAlt}
                width="1200"
                height="800"
                loading="eager"
                decoding="async"
              />
            </div>
            <div class="feat__body">
              <p class="post__meta">
                <span class="post__tag">Latest</span>
                <time datetime={featured.data.pubDate.toISOString()}>
                  {fmt(featured.data.pubDate)}
                </time>
              </p>
              <h2 class="h2 feat__ttl">{featured.data.title}</h2>
              <p class="feat__desc">{featured.data.description}</p>
              <span class="post__more">Read the post →</span>
            </div>
          </a>
        )
      }

      {
        rest.length > 0 && (
          <div class="blog__grid">
            {rest.map((post, i) => (
              <a class="post card" href={`/blog/${post.id}/`} data-reveal data-reveal-index={i}>
                <div class="post__media">
                  <img
                    src={post.data.image}
                    alt={post.data.imageAlt}
                    width="800"
                    height="500"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="post__body">
                  <p class="post__meta">
                    {post.data.tags[0] && <span class="post__tag">{post.data.tags[0]}</span>}
                    <time datetime={post.data.pubDate.toISOString()}>
                      {fmt(post.data.pubDate)}
                    </time>
                  </p>
                  <h2 class="h3 post__ttl">{post.data.title}</h2>
                  <p class="post__desc">{post.data.description}</p>
                  <span class="post__more">Read the post →</span>
                </div>
              </a>
            ))}
          </div>
        )
      }

      {posts.length === 0 && <p class="lede">New posts are on the way.</p>}
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .blog-hero {
    position: relative;
    z-index: 2;
    background: var(--ink-900);
    padding-block: clamp(4rem, 9vw, 7rem) clamp(2.5rem, 5vw, 4rem);
  }

  .blog-hero__h1 {
    font-size: clamp(2.75rem, 8vw, 6.5rem);
    letter-spacing: -0.03em;
    margin-block: 1.25rem;
  }

  .blog-hero__lede {
    max-width: 52ch;
  }

  .blog {
    background: var(--ink-900);
    position: relative;
    z-index: 2;
    padding-top: 0;
  }

  /* ---- Featured ---- */
  .feat {
    display: grid;
    gap: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, var(--ink-700), var(--ink-800));
    overflow: hidden;
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
    transition:
      transform 0.5s var(--ease-out),
      border-color 0.5s var(--ease-out);
  }

  .feat:hover {
    transform: translateY(-4px);
    border-color: var(--line-strong);
  }

  .feat__media {
    overflow: hidden;
    background: var(--ink-600);
    aspect-ratio: 16 / 10;
  }

  .feat__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    transition:
      transform 0.8s var(--ease-out),
      filter 0.6s var(--ease-out);
  }

  .feat:hover .feat__media img {
    transform: scale(1.05);
    filter: grayscale(0) contrast(1);
  }

  .feat__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
    padding: clamp(1.5rem, 3.5vw, 3rem);
    justify-content: center;
  }

  .feat__ttl {
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
  }

  .feat__desc {
    max-width: 52ch;
    color: var(--chrome-2);
  }

  /* ---- Grid ---- */
  .blog__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .post {
    display: flex;
    flex-direction: column;
    padding: 0;
  }

  .post__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--ink-600);
  }

  .post__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    transition:
      transform 0.8s var(--ease-out),
      filter 0.6s var(--ease-out);
  }

  .post:hover .post__media img {
    transform: scale(1.06);
    filter: grayscale(0) contrast(1);
  }

  .post__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.7rem;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    flex: 1;
  }

  .post__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--chrome-3);
  }

  .post__tag {
    padding: 0.22rem 0.6rem;
    border-radius: 100px;
    background: rgba(230, 58, 31, 0.16);
    color: var(--ember-2);
  }

  .post__ttl {
    font-size: 1.375rem;
  }

  .post__desc {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--chrome-3);
  }

  .post__more {
    margin-top: auto;
    padding-top: 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ember-2);
    transition: transform 0.35s var(--ease-out);
  }

  .post:hover .post__more.feat:hover .post__more {
    transform: translateX(4px);
  }

  @media (min-width: 900px) {
    .feat {
      grid-template-columns: 1.1fr 1fr;
    }

    .feat__media {
      aspect-ratio: auto;
      height: 100%;
    }
  }
</style>
