---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { site } from '../../data/site';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
};

const { post } = Astro.props;
const { Content } = await render(post);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });

// Two more posts to read, newest first, excluding this one.
const more = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const pageUrl = new URL(`/blog/${post.id}/`, Astro.site).href;

/**
 * Structured data, emitted as one @graph so the entities can reference each
 * other by @id instead of repeating themselves.
 *
 * ⚠️ The organization @id is `${site.url}/#gym`, matching the one the homepage
 * already emits in src/layouts/Base.astro. Two @ids for the same business is
 * how a knowledge graph ends up with two businesses.
 *
 * ⚠️ NO VideoObject, deliberately. The embed below is ExpertBoxing's video, not
 * Ironhand's. VideoObject markup tells Google the page is the video's home, and
 * claiming someone else's work is not something to do for a rich result. The
 * embed stays, credited on the page. If Ian films 60 seconds of himself
 * wrapping a fighter's hands, that clip is genuinely ours, and then this should
 * carry VideoObject and be the better for it.
 */
const graph: Record<string, unknown>[] = [
  {
    '@type': 'BlogPosting',
    '@id': `${pageUrl}#article`,
    mainEntityOfPage: { '@id': `${pageUrl}#webpage` },
    headline: post.data.title,
    description: post.data.description,
    image: new URL(post.data.ogImage ?? post.data.image, Astro.site).href,
    datePublished: post.data.pubDate.toISOString(),
    dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    author: { '@id': `${site.url}/#ian-sampaga` },
    publisher: { '@id': `${site.url}/#gym` },
    keywords: post.data.tags.join(', '),
    inLanguage: 'en-US',
  },
  {
    '@type': 'WebPage',
    '@id': `${pageUrl}#webpage`,
    url: pageUrl,
    name: post.data.seoTitle ?? post.data.title,
    isPartOf: { '@id': `${site.url}/#gym` },
    breadcrumb: { '@id': `${pageUrl}#breadcrumb` },
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${pageUrl}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${site.url}/blog/` },
      { '@type': 'ListItem', position: 3, name: post.data.title },
    ],
  },
  {
    '@type': 'Person',
    '@id': `${site.url}/#ian-sampaga`,
    name: 'Ian Sampaga',
    jobTitle: 'Founder and Head Coach',
    description:
      'Founder and head coach of Ironhand Boxing in Staten Island, New York. Coaches amateur and professional boxers and personally wraps fighters’ hands on fight night.',
    worksFor: { '@id': `${site.url}/#gym` },
    knowsAbout: ['Boxing', 'Boxing hand wrapping', 'Amateur boxing', 'Boxing coaching'],
    url: `${site.url}/about-us/`,
  },
];

if (post.data.howTo) {
  graph.push({
    '@type': 'HowTo',
    '@id': `${pageUrl}#howto`,
    name: post.data.howTo.name,
    description: post.data.howTo.description,
    ...(post.data.howTo.totalTime ? { totalTime: post.data.howTo.totalTime } : {}),
    supply: post.data.howTo.supply.map((name) => ({ '@type': 'HowToSupply', name })),
    step: post.data.howTo.steps.map((st, i) => ({
      '@type': 'HowToStep',
      position: i + 1,
      name: st.name,
      text: st.text,
    })),
  });
}

if (post.data.faqs?.length) {
  graph.push({
    '@type': 'FAQPage',
    '@id': `${pageUrl}#faq`,
    mainEntity: post.data.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}

const articleSchema = { '@context': 'https://schema.org', '@graph': graph };

/** Per-post hreflang: the Spanish translation, when one exists. */
const altUrl = post.data.translationEs ? `/es/blog/${post.data.translationEs}/` : null;
---

<Base
  title={`${post.data.seoTitle ?? post.data.title} – Ironhand Boxing`}
  description={post.data.description}
  image={post.data.ogImage ?? post.data.image}
  altUrl={altUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} slot="head" />

  <article class="art">
    <header class="art__head gridlines">
      <div class="wrap art__headinner">
        <a class="art__back" href="/blog/">← All posts</a>

        <p class="art__meta" data-reveal>
          {post.data.tags[0] && <span class="art__tag">{post.data.tags[0]}</span>}
          <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
          <span>·</span>
          <span>{post.data.author}</span>
        </p>

        <h1 class="h1 steel art__ttl" data-reveal data-reveal-index="1">{post.data.title}</h1>
        <p class="lede art__desc" data-reveal data-reveal-index="2">{post.data.description}</p>
      </div>
    </header>

    <div class="wrap">
      <figure class="art__hero" data-reveal>
        <img
          src={post.data.image}
          alt={post.data.imageAlt}
          width="1400"
          height="800"
          loading="eager"
          decoding="async"
        />
      </figure>

      <div class="prose">
        <Content />

        {/*
          Rendered from frontmatter rather than written into the post body, so
          the visible steps and the HowTo schema are the same text. See the
          note in src/content.config.ts.
        */}
        {
          post.data.howTo && (
            <ol class="howto">
              {post.data.howTo.steps.map((step) => (
                <li>
                  <strong>{step.name}.</strong> {step.text}
                </li>
              ))}
            </ol>
          )
        }

        {
          post.data.video && (
            <figure class="vid">
              <div class="vid__frame">
                <iframe
                  src={`https://www.youtube-nocookie.com/embed/${post.data.video.id}`}
                  title={post.data.video.title}
                  loading="lazy"
                  allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  referrerpolicy="strict-origin-when-cross-origin"
                  allowfullscreen
                />
              </div>
              <figcaption>{post.data.video.caption}</figcaption>
            </figure>
          )
        }
      </div>

      {
        post.data.faqs?.length && (
          <section class="artfaq">
            <h2 class="h3 artfaq__ttl">Questions we get asked</h2>
            {post.data.faqs.map((f) => (
              <details class="artfaq__item">
                <summary>
                  <span>{f.q}</span>
                  <span class="artfaq__icon" aria-hidden="true" />
                </summary>
                <p>{f.a}</p>
              </details>
            ))}
          </section>
        )
      }

      {
        post.data.tags.length > 0 && (
          <ul class="art__tags">
            {post.data.tags.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        )
      }
    </div>

    {
      more.length > 0 && (
        <section class="section art__more">
          <div class="wrap">
            <h2 class="h3 art__morettl">Keep reading</h2>
            <div class="art__moregrid">
              {more.map((p, i) => (
                <a class="card art__morecard" href={`/blog/${p.id}/`} data-reveal data-reveal-index={i}>
                  <p class="art__moremeta">{fmt(p.data.pubDate)}</p>
                  <h3 class="h3 art__morename">{p.data.title}</h3>
                  <p class="art__moredesc">{p.data.description}</p>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }
  </article>

  <CtaBand />
</Base>

<style>
  /* ---- HowTo steps, rendered from frontmatter ---- */
  .howto {
    counter-reset: howto;
    list-style: none;
    padding: 0;
    margin: 2rem 0;
    display: grid;
    gap: 0.9rem;
  }

  .howto li {
    counter-increment: howto;
    position: relative;
    padding: 0.9rem 1rem 0.9rem 3.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.02);
    line-height: 1.7;
    color: var(--chrome-2);
  }

  .howto li::before {
    content: counter(howto, decimal-leading-zero);
    position: absolute;
    left: 1rem;
    top: 0.95rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ember-2);
  }

  .howto strong {
    color: var(--chrome);
  }

  /* ---- Video ---- */
  .vid {
    margin: 2.5rem 0;
  }

  /* Fixed aspect box so the iframe cannot shift the layout as it loads */
  .vid__frame {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--ink-700);
  }

  .vid__frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .vid figcaption {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: var(--chrome-3);
  }

  /* ---- FAQ ---- */
  .artfaq {
    max-width: 68ch;
    margin: clamp(2.5rem, 5vw, 4rem) auto 0;
  }

  .artfaq__ttl {
    margin-bottom: 1.25rem;
  }

  .artfaq__item {
    border-bottom: 1px solid var(--line);
  }

  .artfaq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    color: var(--chrome);
  }

  .artfaq__item summary::-webkit-details-marker {
    display: none;
  }

  .artfaq__icon {
    position: relative;
    width: 12px;
    height: 12px;
    flex-shrink: 0;
  }

  .artfaq__icon::before,
  .artfaq__icon::after {
    content: '';
    position: absolute;
    background: var(--ember-2);
    transition: transform 0.3s var(--ease-out);
  }

  .artfaq__icon::before {
    inset: 5px 0 5px 0;
    height: 2px;
  }

  .artfaq__icon::after {
    inset: 0 5px 0 5px;
    width: 2px;
  }

  .artfaq__item[open] .artfaq__icon::after {
    transform: scaleY(0);
  }

  .artfaq__item p {
    padding-bottom: 1.1rem;
    color: var(--chrome-2);
    line-height: 1.75;
  }

  .art {
    position: relative;
    z-index: 2;
    background: var(--ink-900);
  }

  .art__head {
    padding-block: clamp(3rem, 7vw, 5.5rem) clamp(2rem, 4vw, 3rem);
    position: relative;
  }

  /* Centred on the same axis as the prose column below, so the title, the lead
     image and the body text all share one left edge instead of stepping. */
  .art__headinner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.1rem;
    max-width: 68ch;
    margin-inline: auto;
  }

  .art__back {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--chrome-3);
    transition: color 0.3s var(--ease-out);
  }

  .art__back:hover {
    color: var(--ember-2);
  }

  .art__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--chrome-3);
  }

  .art__tag {
    padding: 0.22rem 0.6rem;
    border-radius: 100px;
    background: rgba(230, 58, 31, 0.16);
    color: var(--ember-2);
  }

  .art__ttl {
    font-size: clamp(2.25rem, 5.5vw, 4rem);
    letter-spacing: -0.02em;
  }

  .art__desc {
    max-width: 58ch;
  }

  /* Capped and centred rather than full-bleed. At the container's full 1144px
     a 16:9 hero pushed the article's first paragraph clean off the screen; this
     sits just wider than the prose column so it still reads as a lead image. */
  .art__hero {
    max-width: 820px;
    margin: 0 auto clamp(2rem, 4vw, 3.5rem);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--ink-700);
  }

  .art__hero img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  /* ---- Prose ---- */
  .prose {
    max-width: 68ch;
    margin-inline: auto;
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--chrome-2);
  }

  .prose :global(h2) {
    font-size: clamp(1.5rem, 3vw, 2.125rem);
    margin-top: 2.75rem;
    margin-bottom: 1rem;
  }

  .prose :global(h3) {
    font-size: clamp(1.2rem, 2.2vw, 1.5rem);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .prose :global(p) {
    margin-bottom: 1.35rem;
  }

  .prose :global(strong) {
    color: var(--chrome);
    font-weight: 600;
  }

  .prose :global(a) {
    color: var(--ember-2);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: 1.35rem;
    padding-left: 1.35rem;
  }

  .prose :global(li) {
    margin-bottom: 0.5rem;
  }

  .prose :global(li::marker) {
    color: var(--ember);
  }

  .prose :global(blockquote) {
    margin: 2rem 0;
    padding: 1.1rem 1.5rem;
    border-left: 2px solid var(--ember);
    background: rgba(230, 58, 31, 0.06);
    border-radius: 0 10px 10px 0;
    font-size: 0.9375rem;
    color: var(--chrome-2);
  }

  .prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .prose :global(hr) {
    margin: 2.5rem 0;
    border: 0;
    border-top: 1px solid var(--line);
  }

  .prose :global(img) {
    border-radius: var(--radius);
    margin-block: 2rem;
  }

  /* ---- Tags ---- */
  .art__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    max-width: 68ch;
    margin: 2.5rem auto 0;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }

  .art__tags li {
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--line-strong);
    border-radius: 100px;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--chrome-3);
  }

  /* ---- More ---- */
  .art__more {
    padding-bottom: 0;
  }

  .art__morettl {
    margin-bottom: 1.5rem;
  }

  .art__moregrid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .art__morecard {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .art__moremeta {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--chrome-3);
  }

  .art__morename {
    font-size: 1.25rem;
  }

  .art__moredesc {
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--chrome-3);
  }
</style>
