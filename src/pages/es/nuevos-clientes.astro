---
import Base from '../../layouts/Base.astro';
import Schedule from '../../components/Schedule.astro';
import CtaBand from '../../components/CtaBand.astro';
import { monthlyPlans } from '../../data/pricing';
import { photos } from '../../data/photos';

const title = 'Nuevos Clientes – Ironhand Boxing Staten Island';
const description =
  '¿Nunca has boxeado? Aquí está exactamente cómo es tu primera clase en Ironhand Boxing, Staten Island: qué llevar, qué pasa ese día y cómo empezar.';

const steps = [
  {
    n: '01',
    title: 'Escríbenos',
    body: 'Mándanos un mensaje con tu nivel de experiencia y para qué quieres entrenar. Te decimos a qué clase venir primero. Esa respuesta no es la misma para alguien que empieza de cero que para alguien con unas cuantas peleas encima.',
  },
  {
    n: '02',
    title: 'Llega temprano',
    body: 'Ven diez minutos antes de que empiece la clase. Un entrenador te muestra el gimnasio, te venda las manos y te pone los guantes. No necesitas comprar nada para la primera sesión.',
  },
  {
    n: '03',
    title: 'Entrena',
    body: 'Calentamiento y luego fundamentos: la postura, la guardia, el jab. Vas a tener tiempo uno a uno en las manoplas con un entrenador, trabajo de saco y cierre con acondicionamiento. Cerca de una hora.',
  },
  {
    n: '04',
    title: 'Elige tu plan',
    body: 'Cuando veas que te acomoda, te ponemos en la membresía que va con los días que de verdad puedas entrenar. Mes a mes, sin contratos largos.',
  },
];

const bring = [
  'Ropa deportiva con la que puedas moverte',
  'Zapatillas de boxeo',
  'Agua, más de la que crees',
  'Una toalla',
  'Vendas si ya tienes (si no, nosotros te cubrimos)',
];
---

<Base title={title} description={description}>
  <section class="section nc-hero gridlines">
    <div class="wrap">
      <p class="eyebrow" data-reveal>Nuevos Clientes</p>
      <h1 class="display steel nc-hero__h1" data-reveal data-reveal-index="1">
        ¿Nunca has<br />boxeado? Perfecto.
      </h1>
      <p class="lede nc-hero__lede" data-reveal data-reveal-index="2">
        La mayoría de nuestros miembros nunca había tirado un golpe antes de
        entrar. Esto es exactamente lo que pasa el primer día, para que nada te
        tome por sorpresa.
      </p>
      <div class="nc-hero__actions" data-reveal data-reveal-index="3">
        <a class="btn btn--lg" href="/es/contacto/">Reserva tu primera clase</a>
      </div>
    </div>
  </section>

  <section class="section nc-steps">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Cómo Funciona</p>
        <h2 class="h2 steel">Cuatro pasos.</h2>
      </div>

      <ol class="nc-steps__list">
        {
          steps.map((s, i) => (
            <li class="nc-step" data-reveal data-reveal-index={i}>
              <span class="nc-step__n">{s.n}</span>
              <div>
                <h3 class="h3 nc-step__ttl">{s.title}</h3>
                <p class="nc-step__body">{s.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section nc-bring">
    <div class="wrap nc-bring__grid">
      <div data-reveal>
        <p class="eyebrow">Primer Día</p>
        <h2 class="h2 steel">Qué llevar.</h2>
        <ul class="nc-bring__list">
          {bring.map((b) => <li>{b}</li>)}
        </ul>
        <p class="nc-bring__note">
          No compres guantes antes de tu primera clase. Ven a entrenar y deja
          que un entrenador te diga en qué de verdad vale la pena gastar.
        </p>
      </div>

      <div class="nc-bring__media" data-reveal data-reveal-index="1">
        <img
          src={photos.jumpRope.src}
          alt={photos.jumpRope.altEs ?? photos.jumpRope.alt}
          width={photos.jumpRope.width}
          height={photos.jumpRope.height}
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <Schedule lang="es" />

  <section class="section nc-plans">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Membresías</p>
        <h2 class="h2 steel">Mes a mes.</h2>
        <p class="lede">
          Elige según los días que de verdad puedas venir. Puedes subir de plan
          cuando quieras, y la mayoría lo hace.
        </p>
      </div>

      <div class="nc-plans__grid">
        {
          monthlyPlans.map((p, i) => (
            <div class="nc-plan" data-reveal data-reveal-index={i}>
              <span class="nc-plan__name">{p.nameEs}</span>
              <span class="nc-plan__price">${p.price}</span>
              <span class="nc-plan__unit">{p.unitEs}</span>
            </div>
          ))
        }
      </div>

      <p class="nc-plans__more">
        Las sesiones personales, el entrenamiento virtual y el Programa de
        Competidores están completos en la <a href="/es/#pricing">sección de precios</a>.
      </p>
    </div>
  </section>

  <CtaBand
    lang="es"
    title="El primer día ya está en el calendario."
    body="Escríbenos con tu nivel de experiencia y te decimos exactamente a qué clase entrar primero."
    cta="Reserva tu primera clase"
  />
</Base>

<style>
  .nc-hero {
    position: relative;
    z-index: 2;
    background: var(--ink-900);
    padding-block: clamp(4rem, 9vw, 7rem) clamp(3rem, 6vw, 5rem);
  }

  /* Spanish headline words run longer than their English counterparts
     ("PREGÚNTANOS" against "ASK US", "ENTRENADOR" against "COACH"), and Anton
     is a display face with no hyphenation to fall back on. The floor of this
     clamp is lower than the English page's so a single long word still fits a
     320px screen. Astro scopes this style to the Spanish page, the English one
     keeps its larger minimum. */
  .nc-hero__h1 {
    font-size: clamp(2rem, 8vw, 6.5rem);
    letter-spacing: -0.03em;
    margin-block: 1.25rem;
  }

  .nc-hero__lede {
    max-width: 56ch;
  }

  .nc-hero__actions {
    margin-top: 2rem;
  }

  .nc-steps,
  .nc-plans {
    background: var(--ink-900);
    position: relative;
    z-index: 2;
  }

  .nc-steps__list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1px;
    background: var(--line);
    border-block: 1px solid var(--line);
  }

  .nc-step {
    display: flex;
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: flex-start;
    padding: clamp(1.5rem, 3vw, 2.5rem) 0;
    background: var(--ink-900);
    transition: background 0.4s var(--ease-out);
  }

  .nc-step:hover {
    background: var(--ink-800);
  }

  .nc-step__n {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--chrome-3);
    flex-shrink: 0;
    min-width: 2.5ch;
  }

  .nc-step__ttl {
    font-size: 1.375rem;
    margin-bottom: 0.55rem;
  }

  .nc-step__body {
    max-width: 62ch;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--chrome-3);
  }

  .nc-bring {
    background: linear-gradient(180deg, var(--ink-900), var(--ink-800));
    position: relative;
    z-index: 2;
  }

  .nc-bring__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .nc-bring__list {
    list-style: none;
    padding: 0;
    margin-top: 1.75rem;
    display: grid;
    gap: 0.85rem;
  }

  .nc-bring__list li {
    position: relative;
    padding-left: 1.85rem;
    color: var(--chrome-2);
  }

  .nc-bring__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--grad-ember);
  }

  .nc-bring__note {
    margin-top: 1.75rem;
    padding: 1rem 1.25rem;
    border-left: 2px solid var(--ember);
    background: rgba(230, 58, 31, 0.06);
    border-radius: 0 10px 10px 0;
    font-size: var(--fs-sm);
    color: var(--chrome-2);
  }

  .nc-bring__media {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--line);
  }

  .nc-bring__media img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
  }

  .nc-plans__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .nc-plan {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.5rem;
    background: var(--ink-800);
    transition: background 0.4s var(--ease-out);
  }

  .nc-plan:hover {
    background: var(--ink-700);
  }

  .nc-plan__name {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--chrome-3);
  }

  .nc-plan__price {
    font-family: var(--font-display);
    font-size: 2.25rem;
    line-height: 1;
    color: var(--chrome);
  }

  .nc-plan__unit {
    font-size: 0.75rem;
    color: var(--chrome-3);
  }

  .nc-plans__more {
    margin-top: 1.5rem;
    font-size: var(--fs-sm);
    color: var(--chrome-3);
  }

  .nc-plans__more a {
    color: var(--ember-2);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (min-width: 900px) {
    .nc-bring__grid {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }
</style>
