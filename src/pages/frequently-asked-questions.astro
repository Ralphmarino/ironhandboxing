---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { faqs } from '../data/faqs';

// Title preserved from the WordPress site — it ranks for local FAQ queries.
const title = 'Boxing Frequently Asked Questions - Staten Island';
const description =
  'Answers to the questions we hear most at Ironhand Boxing in Staten Island — starting out with no experience, class structure, pricing, kids programs and competing.';

const groups = [...new Set(faqs.map((f) => f.group))];

// FAQPage schema makes these eligible for rich results in search.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

  <section class="section faq-hero gridlines">
    <div class="wrap">
      <p class="eyebrow" data-reveal>FAQ</p>
      <h1 class="display steel faq-hero__h1" data-reveal data-reveal-index="1">
        Ask us<br />anything.
      </h1>
      <p class="lede faq-hero__lede" data-reveal data-reveal-index="2">
        The questions we get asked most, answered straight. If yours is not
        here, message us — we would rather answer it than have you guess.
      </p>
    </div>
  </section>

  <section class="section faq">
    <div class="wrap">
      <div class="faq__filters" data-reveal>
        <button class="chip" data-faq-filter="all" aria-pressed="true">All</button>
        {
          groups.map((g) => (
            <button class="chip" data-faq-filter={g} aria-pressed="false">
              {g}
            </button>
          ))
        }
      </div>

      <div class="faq__list">
        {
          faqs.map((f, i) => (
            <details class="qa" data-faq-group={f.group} data-reveal data-reveal-index={i % 6}>
              <summary class="qa__q">
                <span>{f.q}</span>
                <span class="qa__icon" aria-hidden="true" />
              </summary>
              <div class="qa__a">
                <p>{f.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    title="Still got a question?"
    body="Send it over. A real person at the gym reads every message and answers it."
    cta="Ask us"
  />
</Base>

<style>
  .faq-hero {
    position: relative;
    z-index: 2;
    background: var(--ink-900);
    padding-block: clamp(4rem, 9vw, 7rem) clamp(2.5rem, 5vw, 4rem);
  }

  .faq-hero__h1 {
    font-size: clamp(2.75rem, 8vw, 6.5rem);
    letter-spacing: -0.03em;
    margin-block: 1.25rem;
  }

  .faq-hero__lede {
    max-width: 56ch;
  }

  .faq {
    background: var(--ink-900);
    position: relative;
    z-index: 2;
    padding-top: 0;
  }

  .faq__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
  }

  .chip {
    padding: 0.5rem 1.05rem;
    border: 1px solid var(--line-strong);
    border-radius: 100px;
    background: transparent;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--chrome-2);
    cursor: pointer;
    transition:
      background 0.3s var(--ease-out),
      border-color 0.3s var(--ease-out),
      color 0.3s var(--ease-out);
  }

  .chip:hover {
    border-color: var(--ember-2);
    color: var(--chrome);
  }

  .chip[aria-pressed='true'] {
    background: var(--grad-ember);
    border-color: transparent;
    color: #fff;
  }

  .faq__list {
    display: grid;
    gap: 0.6rem;
  }

  .qa {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: linear-gradient(180deg, var(--ink-700), var(--ink-800));
    overflow: hidden;
    transition: border-color 0.4s var(--ease-out);
  }

  .qa[open] {
    border-color: rgba(230, 58, 31, 0.35);
  }

  .qa__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.15rem clamp(1rem, 2.5vw, 1.6rem);
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-size: clamp(1.0625rem, 1.8vw, 1.3rem);
    text-transform: uppercase;
    letter-spacing: 0.005em;
    color: var(--chrome);
  }

  /* Hide the native disclosure triangle in both engines */
  .qa__q::-webkit-details-marker {
    display: none;
  }

  .qa__icon {
    position: relative;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .qa__icon::before,
  .qa__icon::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto 0;
    height: 2px;
    background: var(--ember-2);
    border-radius: 2px;
    transition: transform 0.35s var(--ease-out);
  }

  .qa__icon::after {
    rotate: 90deg;
  }

  .qa[open] .qa__icon::after {
    transform: scaleX(0);
  }

  .qa__a {
    padding: 0 clamp(1rem, 2.5vw, 1.6rem) 1.35rem;
  }

  .qa__a p {
    max-width: 72ch;
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--chrome-2);
  }

  /* Content fades in rather than snapping when the panel opens */
  .qa[open] .qa__a {
    animation: qaIn 0.4s var(--ease-out) both;
  }

  @keyframes qaIn {
    from {
      opacity: 0;
      translate: 0 -6px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
</style>
