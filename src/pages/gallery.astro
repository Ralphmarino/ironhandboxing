---
import Base from '../layouts/Base.astro';
import InstagramFeed from '../components/InstagramFeed.astro';
import CtaBand from '../components/CtaBand.astro';

// Title preserved from the WordPress site.
const title = 'Boxing Gym Gallery - Pictures of Boxing Staten Island';
const description =
  'Photos from inside Ironhand Boxing in Staten Island — group classes, mitt work, kids and teens, and our amateur fighters in the ring.';

// Real gym photos — see src/data/photos.ts for the catalogue and alt text.
import { galleryPhotos } from '../data/photos';
---

<Base title={title} description={description}>
  <section class="section gal-hero gridlines">
    <div class="wrap">
      <p class="eyebrow" data-reveal>Gallery</p>
      <h1 class="display steel gal-hero__h1" data-reveal data-reveal-index="1">
        Inside the<br />gym.
      </h1>
      <p class="lede gal-hero__lede" data-reveal data-reveal-index="2">
        Real classes, real members, real work. This is what a night at Ironhand
        actually looks like.
      </p>
    </div>
  </section>

  <section class="section gal">
    <div class="wrap">
      <div class="gal__grid">
        {
          galleryPhotos.map((p, i) => (
            <figure
              class={`gal__item ${p.span ? `gal__item--${p.span}` : ''}`}
              data-reveal
              data-reveal-index={i % 6}
            >
              <img
                src={p.src}
                alt={p.alt}
                width={p.width}
                height={p.height}
                loading={i < 3 ? 'eager' : 'lazy'}
                decoding="async"
              />
              <figcaption class="visually-hidden">{p.alt}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <InstagramFeed />
  <CtaBand
    title="Get in one of these photos."
    body="The next class is on the schedule. Message us and we will save you a spot."
    cta="Book your first class"
  />
</Base>

<style>
  .gal-hero {
    position: relative;
    z-index: 2;
    background: var(--ink-900);
    padding-block: clamp(4rem, 9vw, 7rem) clamp(2.5rem, 5vw, 4rem);
  }

  .gal-hero__h1 {
    font-size: clamp(2.75rem, 8vw, 6.5rem);
    letter-spacing: -0.03em;
    margin-block: 1.25rem;
  }

  .gal-hero__lede {
    max-width: 52ch;
  }

  .gal {
    background: var(--ink-900);
    position: relative;
    z-index: 2;
    padding-top: 0;
  }

  /* Dense auto-flow mosaic — items opt into wider/taller cells so the grid
     reads as edited rather than uniform. */
  .gal__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    grid-auto-rows: 180px;
    grid-auto-flow: dense;
    gap: 0.6rem;
  }

  .gal__item {
    margin: 0;
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--ink-700);
    border: 1px solid var(--line);
  }

  .gal__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.06);
    transition:
      transform 0.8s var(--ease-out),
      filter 0.6s var(--ease-out);
  }

  .gal__item:hover img {
    transform: scale(1.07);
    filter: grayscale(0) contrast(1);
  }

  /* Ember wash on hover, so a mostly-monochrome grid still feels alive */
  .gal__item::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 55%, rgba(230, 58, 31, 0.28));
    opacity: 0;
    transition: opacity 0.5s var(--ease-out);
    pointer-events: none;
  }

  .gal__item:hover::after {
    opacity: 1;
  }

  @media (min-width: 700px) {
    .gal__grid {
      grid-auto-rows: 220px;
    }

    .gal__item--wide {
      grid-column: span 2;
    }

    .gal__item--tall {
      grid-row: span 2;
    }
  }
</style>
