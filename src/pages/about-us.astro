---
import Base from '../layouts/Base.astro';
import Coaches from '../components/Coaches.astro';
import CtaBand from '../components/CtaBand.astro';
import Ticker from '../components/Ticker.astro';
import { photos } from '../data/photos';

const title = 'About Us – Ironhand Boxing';
const description =
  'Ironhand Boxing was founded by Ian Sampaga to serve, influence and inspire our Staten Island community through world-class boxing training for all ages and levels.';

const values = [
  {
    title: 'Everyone gets coached',
    body: 'One-on-one mitt work is built into every single class. You are not left to figure out a heavy bag on your own. A coach puts hands on the pads with you, every time.',
  },
  {
    title: 'Family first, always',
    body: 'Kids train here. Parents train here. People in their sixties train here. The room is built so a nervous first-timer and an amateur competitor can share it without either one feeling out of place.',
  },
  {
    title: 'Technique over ego',
    body: 'Sparring is optional and supervised. Nobody is thrown in to see if they sink. Fundamentals come first and they keep coming first, no matter how long you have been here.',
  },
  {
    title: 'Real Staten Island',
    body: 'This is a neighborhood gym on Castleton Avenue, not a franchise. NYC grit and a room full of people who actually know each other’s names.',
  },
];
---

<Base title={title} description={description}>
  <section class="section abt-hero gridlines">
    <div class="wrap">
      <p class="eyebrow" data-reveal>About Ironhand</p>
      <h1 class="display steel abt-hero__h1" data-reveal data-reveal-index="1">
        Built by a coach,<br />not a chain.
      </h1>
      <p class="lede abt-hero__lede" data-reveal data-reveal-index="2">
        Ironhand Boxing on Staten Island was founded by Ian Sampaga to serve,
        influence and inspire our clients and members of our community through
        world-class boxing training. Ian’s commitment to the sport of boxing
        inspired the opening of Ironhand.
      </p>
    </div>
  </section>

  <Ticker lang="en" />

  <section class="section abt-story">
    <div class="wrap abt-story__grid">
      <div class="abt-story__media" data-reveal>
        <img
          src={photos.teamPhoto.src}
          alt={photos.teamPhoto.alt}
          width={photos.teamPhoto.width}
          height={photos.teamPhoto.height}
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="abt-story__copy" data-reveal data-reveal-index="1">
        <p class="eyebrow">The Gym</p>
        <h2 class="h2 steel">A room that gives back what you put in.</h2>
        <p>
          Ironhand has earned its reputation as Staten Island’s premier boxing
          training facility by doing an unglamorous thing consistently: coaching
          every person in the room properly. Programs are built so every member
          gets training suited to what they actually need, whether that is
          sharpening technique, working the mitts, getting rounds on the bag, or
          simply getting into the best shape of their life.
        </p>
        <p>
          Classes are designed for every level, from people exploring boxing for
          the first time to seasoned competitors refining their craft. What ties
          them together is the standard: proper technique, one-on-one attention,
          and a room where respect is the price of entry.
        </p>
        <p>
          Ian no longer coaches alone. Ironhand now runs with a full staff, certified coaches, active amateur competitors, and fighters who came up
          through this program and stayed to teach it.
        </p>
      </div>
    </div>
  </section>

  <section class="section abt-values">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">What We Stand On</p>
        <h2 class="h2 steel">Four things we don’t bend on.</h2>
      </div>

      <div class="abt-values__grid">
        {
          values.map((v, i) => (
            <article class="card" data-reveal data-reveal-index={i}>
              <h3 class="h3 abt-values__ttl">{v.title}</h3>
              <p class="abt-values__body">{v.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <Coaches lang="en" />
  <CtaBand
    title="Come see the room."
    body="The best way to understand Ironhand is to walk in during a class. Reach out and we will tell you which one to come to."
    cta="Get in touch"
  />
</Base>

<style>
  .abt-hero {
    position: relative;
    z-index: 2;
    background: var(--ink-900);
    padding-block: clamp(4rem, 9vw, 7rem) clamp(3rem, 6vw, 5rem);
  }

  .abt-hero__h1 {
    font-size: clamp(2.75rem, 8vw, 6.5rem);
    letter-spacing: -0.03em;
    margin-block: 1.25rem;
  }

  .abt-hero__lede {
    max-width: 60ch;
  }

  .abt-story {
    background: var(--ink-900);
    position: relative;
    z-index: 2;
  }

  .abt-story__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .abt-story__media {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--ink-700);
  }

  .abt-story__media img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
  }

  .abt-story__copy {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    align-items: flex-start;
  }

  .abt-story__copy p {
    max-width: 58ch;
    color: var(--chrome-2);
  }

  .abt-values {
    background: linear-gradient(180deg, var(--ink-900), var(--ink-800));
    position: relative;
    z-index: 2;
  }

  .abt-values__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .abt-values__ttl {
    font-size: 1.375rem;
    margin-bottom: 0.7rem;
  }

  .abt-values__body {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--chrome-3);
  }

  @media (min-width: 900px) {
    .abt-story__grid {
      grid-template-columns: 0.85fr 1.15fr;
    }
  }
</style>
