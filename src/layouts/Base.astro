---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import BackToTop from '../components/BackToTop.astro';
import { site } from '../data/site';
import { schedule } from '../data/schedule';

/** "6:00 PM" -> 18, for sorting and for schema's 24-hour format. */
const hour24 = (t: string) => {
  const [, h, m, ap] = t.match(/(\d+):(\d+)\s*(AM|PM)/i)!;
  let hh = Number(h) % 12;
  if (ap.toUpperCase() === 'PM') hh += 12;
  return hh + Number(m) / 60;
};
const hhmm = (v: number) =>
  `${String(Math.floor(v)).padStart(2, '0')}:${String(Math.round((v % 1) * 60)).padStart(2, '0')}`;

const byDay = new Map<string, number[]>();
for (const slot of schedule) {
  byDay.set(slot.day, [...(byDay.get(slot.day) ?? []), hour24(slot.time)]);
}

const openingHours = [...byDay.entries()].map(([day, hours]) => ({
  '@type': 'OpeningHoursSpecification',
  dayOfWeek: [day],
  opens: hhmm(Math.min(...hours)),
  closes: hhmm(Math.max(...hours) + 1),
}));

interface Props {
  title: string;
  description: string;
  /** Set true only on the homepage, it renders the full LocalBusiness schema. */
  isHome?: boolean;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  isHome = false,
  // Purpose-built 1200x630 share card. Blog posts override this with their own
  // hero image; everything else gets the branded default.
  image = '/og-image.jpg',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SportsActivityLocation',
  '@id': `${site.url}/#gym`,
  name: site.legalName,
  alternateName: site.name,
  url: site.url,
  description,
  image: ogImage,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.locality,
    addressRegion: site.address.region,
    postalCode: site.address.postalCode,
    addressCountry: site.address.country,
  },
  ...(site.phone ? { telephone: site.phone } : {}),
  sameAs: [site.social.instagram],
  founder: { '@type': 'Person', name: 'Ian Sampaga' },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: site.reviews.rating,
    reviewCount: site.reviews.count,
    bestRating: 5,
  },
  // Derived from src/data/schedule.ts rather than hand-written, so adding or
  // moving a class updates the structured data too. Classes run about an hour,
  // so each day opens at its first class and closes an hour after its last.
  openingHoursSpecification: openingHours,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta name="theme-color" content="#08090b" />
    {/* Favicons carry an opaque dark plate, the badge artwork is white and
        would disappear on a light browser tab. */}
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700&display=swap"
    />

    {isHome && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    {/* Pages inject their own structured data (FAQPage, BlogPosting) here. */}
    <slot name="head" />

    <!-- Set synchronously so reveal styles only apply when JS can undo them.
         Without this, a JS failure would leave the page permanently blank. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="grain" aria-hidden="true"></div>

    {/* Sits above the sticky header, so it scrolls away and the nav takes over. */}
    {isHome && <AnnouncementBar />}
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <BackToTop />

    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
