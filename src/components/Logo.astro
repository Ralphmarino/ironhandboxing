---
/**
 * Ironhand Boxing badge.
 *
 * This renders the real logo artwork (`public/logo.png`) rather than a vector
 * recreation. The source is white-on-transparent, which is exactly right on the
 * dark shell, no recolouring needed.
 *
 * The file is a 768px indexed PNG (~45KB). Indexed beats WebP by ~4x here:
 * the artwork is high-contrast line work, which lossy codecs handle badly and
 * a 16-colour palette handles almost perfectly. One file serves every size on
 * the site, so it is fetched once and cached.
 *
 * Master source is kept in art-masters/, which is outside public/ so the
 * full-size artwork is never shipped. See art-masters/README.md to regenerate.
 *
 * For the chrome medallion version of the mark, see Medallion.astro.
 */
interface Props {
  /** Number for px, or a CSS length such as "100%" to fill the parent. */
  size?: number | string;
  class?: string;
  /** Above-the-fold instances should pass eager. */
  loading?: 'eager' | 'lazy';
  title?: string;
}

const {
  size = 200,
  class: className = '',
  loading = 'lazy',
  title = 'Ironhand Boxing, Staten Island',
} = Astro.props;

const numeric = typeof size === 'number';
---

<img
  class={`ih-logo ${className}`}
  src="/logo.png"
  alt={title}
  width={numeric ? size : 768}
  height={numeric ? size : 768}
  style={numeric ? undefined : `width:${size};height:auto`}
  loading={loading}
  decoding="async"
/>

<style>
  .ih-logo {
    /* The artwork is square after trimming, so this never distorts. */
    object-fit: contain;
    /* Stops the badge picking up the grayscale treatment used on photos. */
    filter: none;
  }
</style>
