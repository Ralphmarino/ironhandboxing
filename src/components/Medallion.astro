---
/**
 * The chrome medallion: the Ironhand mark rendered as a struck metal badge.
 *
 * Kept separate from <Logo>, which is the flat white line art. The two are not
 * interchangeable. The flat mark is what belongs at 46px in the header, where
 * the medallion's modelling would turn to mush. The medallion belongs anywhere
 * it gets to be big.
 *
 * A glint travels across it every few seconds and again on hover. The light is
 * masked by the artwork's own alpha, so it only ever falls on metal, never on
 * the transparent square around the disc.
 *
 * Assets are derived from art-masters/medallion-2000.png. WebP is 88KB against
 * 479KB for the equivalent PNG, so the PNG here is a fallback only, and smaller
 * because almost nobody will fetch it.
 */
interface Props {
  /** CSS length for the width. Height follows, the artwork is square. */
  size?: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  /** Empty alt when the badge is decorative and the page already says the name. */
  alt?: string;
}

const {
  size = '100%',
  class: className = '',
  loading = 'lazy',
  alt = 'Ironhand Boxing, Staten Island',
} = Astro.props;
---

<span class={`med ${className}`} style={`width:${size}`}>
  <picture>
    <source srcset="/medallion.webp" type="image/webp" />
    <img
      class="med__img"
      src="/medallion.png"
      alt={alt}
      width="800"
      height="800"
      loading={loading}
      decoding="async"
    />
  </picture>

  <span class="med__glint" aria-hidden="true"><i></i></span>
</span>

<style>
  .med {
    position: relative;
    display: block;
    aspect-ratio: 1;
    isolation: isolate;
  }

  .med__img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* The glint layer is cut to the medallion's own silhouette, so the sweep
     runs across the metal and stops dead at the rim. */
  .med__glint {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    -webkit-mask: url('/medallion.png') center / contain no-repeat;
    mask: url('/medallion.png') center / contain no-repeat;
  }

  /* Without masking, the sweep would read as a bright rectangle over the
     transparent corners. Better to show no glint at all. */
  @supports not ((-webkit-mask: url('/medallion.png')) or (mask: url('/medallion.png'))) {
    .med__glint {
      display: none;
    }
  }

  .med__glint i {
    position: absolute;
    top: -25%;
    bottom: -25%;
    left: 0;
    width: 34%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.16) 35%,
      rgba(255, 255, 255, 0.62) 50%,
      rgba(255, 255, 255, 0.16) 65%,
      transparent
    );
    mix-blend-mode: screen;
    transform: translateX(-160%) skewX(-16deg);
    animation: glint 9s var(--ease-out) infinite;
  }

  /* Long pause, quick pass. A constant shimmer would look cheap, an
     occasional catch of light looks like metal. */
  @keyframes glint {
    0%,
    82% {
      transform: translateX(-160%) skewX(-16deg);
    }
    97%,
    100% {
      transform: translateX(460%) skewX(-16deg);
    }
  }

  /* Hover restarts the pass immediately rather than waiting out the cycle. */
  .med:hover .med__glint i {
    animation: glint-once 1.1s var(--ease-out);
  }

  @keyframes glint-once {
    from {
      transform: translateX(-160%) skewX(-16deg);
    }
    to {
      transform: translateX(460%) skewX(-16deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .med__glint {
      display: none;
    }
  }
</style>
