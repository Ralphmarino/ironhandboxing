---
import { testimonials } from '../data/testimonials';
import { site } from '../data/site';

// Two counter-scrolling rows read as motion without becoming a slideshow the
// visitor has to wait on.
const mid = Math.ceil(testimonials.length / 2);
const rows = [testimonials.slice(0, mid), testimonials.slice(mid)];
---

<section class="section revs" id="reviews">
  <div class="wrap">
    <div class="section-head revs__head" data-reveal>
      <p class="eyebrow">From the Neighborhood</p>
      <h2 class="h2 steel">
        {site.reviews.count}+ five-star<br />reviews. Zero luck.
      </h2>
      <a class="revs__badge" href={site.reviews.url} rel="noopener" target="_blank">
        <span class="revs__stars" aria-hidden="true">★★★★★</span>
        <span class="revs__badgetxt">
          <strong>{site.reviews.rating.toFixed(1)}</strong> on Google
        </span>
      </a>
    </div>
  </div>

  {
    rows.map((row, rowIndex) => (
      <div class={`marquee revs__row ${rowIndex === 1 ? 'revs__row--rev' : ''}`}>
        <div class="marquee__track">
          {row.map((t) => (
            <figure class="rev">
              <span class="rev__stars" aria-hidden="true">
                ★★★★★
              </span>
              <blockquote class="rev__quote">{t.quote}</blockquote>
              <figcaption class="rev__by">
                <span class="rev__avatar" aria-hidden="true">
                  {t.name.charAt(0)}
                </span>
                <span>
                  <strong>{t.name}</strong>
                  <small>{t.date} · Google Review</small>
                </span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    ))
  }
</section>

<style>
  .revs {
    background: linear-gradient(180deg, var(--ink-800), var(--ink-900));
    overflow: hidden;
    position: relative;
    z-index: 2;
  }

  .revs__head {
    max-width: none;
  }

  .revs__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    align-self: flex-start;
    padding: 0.65rem 1.15rem;
    border: 1px solid var(--line);
    border-radius: 100px;
    background: rgba(255, 255, 255, 0.03);
    transition: border-color 0.35s var(--ease-out);
  }

  .revs__badge:hover {
    border-color: var(--line-strong);
  }

  .revs__stars {
    color: var(--gold);
    letter-spacing: 0.08em;
  }

  .revs__badgetxt {
    font-size: 0.8125rem;
    color: var(--chrome-2);
  }

  .revs__badgetxt strong {
    color: var(--chrome);
  }

  .revs__row {
    --marquee-dur: 70s;
    margin-top: 1rem;
  }

  .revs__row--rev .marquee__track {
    animation-direction: reverse;
    --marquee-dur: 88s;
  }

  .rev {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    flex-shrink: 0;
    width: min(85vw, 380px);
    padding: 1.5rem;
    margin: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, var(--ink-700), var(--ink-800));
    transition: border-color 0.4s var(--ease-out);
  }

  .rev:hover {
    border-color: var(--line-strong);
  }

  .rev__stars {
    color: var(--gold);
    font-size: 0.875rem;
    letter-spacing: 0.12em;
  }

  .rev__quote {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--chrome-2);
    /* Cards sit in a fixed-height row; clamp keeps the strip level without
       truncating any review down to a meaningless fragment. */
    display: -webkit-box;
    -webkit-line-clamp: 6;
    line-clamp: 6;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .rev__by {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: auto;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
  }

  .rev__avatar {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--grad-ember);
    font-family: var(--font-display);
    font-size: 1rem;
    color: #fff;
  }

  .rev__by strong {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--chrome);
  }

  .rev__by small {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--chrome-3);
  }
</style>
