---
import { photos } from '../data/photos';

const offers = [
  {
    n: '01',
    photo: photos.teamPhoto,
    title: 'Group Classes',
    body: 'The core of the gym. Technique, one-on-one mitt work with a coach, bag work and conditioning. Every session, seven days a week. Beginners and experienced boxers train on the same floor at their own level.',
    tag: 'All levels',
  },
  {
    n: '02',
    photo: photos.personalSession,
    title: 'Personal Sessions',
    body: 'One-on-one hours with Coach Ian, set aside Wednesdays and Thursdays. This is where technique gets fixed properly, and where members chasing a specific goal make the fastest progress.',
    tag: '2 for $250',
  },
  {
    n: '03',
    photo: photos.kidsStance,
    title: 'Kids & Teens',
    body: 'Fridays at 5pm. Coordination, discipline and confidence first; boxing second. Parents keep telling us the same thing: their kid comes home wanting to show them what they learned.',
    tag: 'Fridays 5PM',
  },
  {
    n: '04',
    photo: photos.fightersProgram,
    title: 'Fighters Program',
    body: 'The competition track. Monday, Tuesday, Wednesday and Friday at 7pm for registered amateurs actively campaigning. Rounds, ring work and corner-ready preparation.',
    tag: 'Book required',
  },
];
---

<section class="section offer" id="offer">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <p class="eyebrow">What We Offer</p>
      <h2 class="h2 steel">Four ways in.</h2>
      <p class="lede">
        Whether you have never thrown a punch or you are three fights into an
        amateur career, there is a lane here, and a coach in it with you.
      </p>
    </div>

    <div class="offer__grid">
      {
        offers.map((o, i) => (
          <article class="card offer__card" data-reveal data-reveal-index={i}>
            <div class="offer__media">
              <img
                src={o.photo.src}
                alt={o.photo.alt}
                width={o.photo.width}
                height={o.photo.height}
                loading="lazy"
                decoding="async"
              />
              <span class="offer__n">{o.n}</span>
            </div>
            <h3 class="h3 offer__ttl">{o.title}</h3>
            <p class="offer__body">{o.body}</p>
            <span class="offer__tag">{o.tag}</span>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .offer {
    background: var(--ink-900);
    position: relative;
    z-index: 2;
  }

  /* 238px min lets all four cards share one row inside the 1144px content
     width at desktop; 270px forced a lopsided 3 + 1 wrap. */
  .offer__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(238px, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .offer__card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    /* Image runs edge to edge, so the padding moves onto the text below */
    padding: 0 0 clamp(1.25rem, 2.5vw, 1.75rem);
    overflow: hidden;
  }

  .offer__media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--ink-600);
    margin-bottom: 0.35rem;
  }

  .offer__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.06);
    transition:
      transform 0.8s var(--ease-out),
      filter 0.6s var(--ease-out);
  }

  .offer__card:hover .offer__media img {
    transform: scale(1.06);
    filter: grayscale(0) contrast(1);
  }

  .offer__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 45%, var(--ink-800));
    pointer-events: none;
  }

  .offer__n {
    position: absolute;
    left: clamp(1.25rem, 2.5vw, 1.75rem);
    bottom: 0.6rem;
    z-index: 1;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    color: var(--ember-2);
  }

  .offer__ttl,
  .offer__body,
  .offer__tag {
    margin-inline: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .offer__ttl {
    font-size: 1.5rem;
  }

  .offer__body {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--chrome-3);
  }

  .offer__tag {
    margin-top: auto;
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--line-strong);
    border-radius: 100px;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--chrome-2);
  }
</style>
