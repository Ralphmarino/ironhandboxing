---
import { monthlyPlans, sessionPlans, fightersProgram, coachTrainingFee } from '../data/pricing';
---

<section class="section pricing" id="pricing">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <p class="eyebrow">What We Offer</p>
      <h2 class="h2 steel">Pick your rounds.</h2>
      <p class="lede">
        Month-to-month memberships built around how often you can actually get
        in. Train more, pay less per session, and the heavier plans include
        one-on-one time with Coach Ian.
      </p>
    </div>

    <h3 class="pricing__sub" data-reveal>Monthly Memberships</h3>
    <div class="pricing__grid">
      {
        monthlyPlans.map((plan, i) => (
          <div
            class={`card plan ${plan.featured ? 'plan--featured' : ''}`}
            data-reveal
            data-reveal-index={i}
          >
            {plan.featured && <span class="plan__flag">Most popular</span>}
            <p class="plan__name">{plan.name}</p>
            <p class="plan__price">
              <span class="plan__cur">$</span>
              {plan.price}
            </p>
            <p class="plan__unit">{plan.unit}</p>
            {plan.note && <p class="plan__note">{plan.note}</p>}
          </div>
        ))
      }
    </div>

    <h3 class="pricing__sub pricing__sub--gap" data-reveal>Sessions & Add-Ons</h3>
    <div class="pricing__grid">
      {
        sessionPlans.map((plan, i) => (
          <div
            class={`card plan ${plan.featured ? 'plan--featured' : ''}`}
            data-reveal
            data-reveal-index={i}
          >
            <p class="plan__name">{plan.name}</p>
            <p class="plan__price">
              {plan.price !== 'TBD' && <span class="plan__cur">$</span>}
              {plan.price}
            </p>
            <p class="plan__unit">{plan.unit}</p>
            {plan.note && <p class="plan__note">{plan.note}</p>}
          </div>
        ))
      }
    </div>

    <!-- Fighters Program, the competition track, styled apart from membership -->
    <div class="fighters" id="fighters" data-reveal>
      <div class="fighters__glow" aria-hidden="true"></div>

      <div class="fighters__body">
        <p class="eyebrow">By Invitation</p>
        <h3 class="h2 fighters__ttl">{fightersProgram.name}</h3>
        <p class="fighters__days">{fightersProgram.days}</p>
        <p class="fighters__blurb">{fightersProgram.blurb}</p>
        <p class="fighters__req">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 4v16l8-3 8 3V4a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2z"></path>
          </svg>
          {fightersProgram.requirement}
        </p>
      </div>

      <div class="fighters__price">
        <p class="plan__price plan__price--xl">
          <span class="plan__cur">$</span>{fightersProgram.price}
        </p>
        <p class="plan__unit">{fightersProgram.unit}</p>
        <a class="btn" href="/contact-us/?interest=fighters">Ask about the program</a>
      </div>
    </div>

    <div class="coachfee card" data-reveal>
      <div>
        <p class="coachfee__ttl">Training with one of our coaches</p>
        <p class="coachfee__blurb">{coachTrainingFee.blurb}</p>
      </div>
      <p class="coachfee__price">
        <span class="plan__cur">$</span>{coachTrainingFee.price}
        <small>{coachTrainingFee.unit}</small>
      </p>
    </div>
  </div>
</section>

<style>
  .pricing {
    background: linear-gradient(180deg, var(--ink-900), var(--ink-800));
    position: relative;
    z-index: 2;
  }

  .pricing__sub {
    font-family: var(--font-mono);
    font-size: var(--fs-eyebrow);
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--chrome-3);
    margin-bottom: 1.25rem;
  }

  .pricing__sub--gap {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .pricing__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 1rem;
  }

  .plan {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 1.5rem;
  }

  .plan--featured {
    border-color: rgba(230, 58, 31, 0.4);
    background: linear-gradient(180deg, rgba(230, 58, 31, 0.09), var(--ink-800));
  }

  .plan--featured::after {
    transform: scaleX(1);
  }

  .plan__flag {
    align-self: flex-start;
    margin-bottom: 0.6rem;
    padding: 0.25rem 0.65rem;
    border-radius: 100px;
    background: var(--grad-ember);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fff;
  }

  .plan__name {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--chrome-2);
  }

  .plan__price {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 3.25rem);
    line-height: 1;
    color: var(--chrome);
    margin-top: 0.5rem;
    font-variant-numeric: tabular-nums;
  }

  .plan__price--xl {
    font-size: clamp(3.5rem, 8vw, 5rem);
  }

  .plan__cur {
    font-size: 0.45em;
    vertical-align: super;
    color: var(--ember-2);
    margin-right: 0.1em;
  }

  .plan__unit {
    font-size: 0.8125rem;
    color: var(--chrome-3);
  }

  .plan__note {
    margin-top: 0.6rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--line);
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--chrome-2);
  }

  /* ---- Fighters ---- */
  .fighters {
    position: relative;
    display: grid;
    gap: 2rem;
    align-items: center;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding: clamp(1.75rem, 4vw, 3rem);
    border: 1px solid rgba(230, 58, 31, 0.3);
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, rgba(230, 58, 31, 0.1), var(--ink-700) 60%);
    overflow: hidden;
  }

  .fighters__glow {
    position: absolute;
    top: -30%;
    left: -10%;
    width: 55%;
    aspect-ratio: 1;
    background: radial-gradient(circle, rgba(255, 122, 41, 0.25), transparent 70%);
    filter: blur(30px);
    pointer-events: none;
  }

  .fighters__body {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    align-items: flex-start;
  }

  .fighters__ttl {
    font-size: clamp(2rem, 4.5vw, 3rem);
  }

  .fighters__days {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ember-2);
  }

  .fighters__blurb {
    max-width: 52ch;
    color: var(--chrome-2);
  }

  .fighters__req {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 1rem;
    border: 1px dashed rgba(255, 255, 255, 0.2);
    border-radius: 10px;
    font-size: 0.8125rem;
    color: var(--chrome);
  }

  .fighters__req svg {
    color: var(--gold);
    flex-shrink: 0;
  }

  .fighters__price {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
  }

  .fighters__price .btn {
    margin-top: 1rem;
  }

  /* ---- Coach fee ---- */
  .coachfee {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: center;
    justify-content: space-between;
    margin-top: 1rem;
  }

  .coachfee__ttl {
    font-family: var(--font-display);
    font-size: 1.25rem;
    text-transform: uppercase;
    color: var(--chrome);
  }

  .coachfee__blurb {
    margin-top: 0.4rem;
    max-width: 60ch;
    font-size: var(--fs-sm);
    color: var(--chrome-3);
  }

  .coachfee__price {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    line-height: 1;
    color: var(--chrome);
    white-space: nowrap;
  }

  .coachfee__price small {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--chrome-3);
    margin-top: 0.35rem;
  }

  @media (min-width: 880px) {
    .fighters {
      grid-template-columns: 1.6fr auto;
    }
  }
</style>
