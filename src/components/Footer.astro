---
import Logo from './Logo.astro';
import { site } from '../data/site';
import { path as route, type Lang } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const es = lang === 'es';
const home = route('home', lang);

const year = new Date().getFullYear();

const cols = [
  {
    title: es ? 'Entrena' : 'Train',
    links: [
      { href: route('newClients', lang), label: t('nav.newClients') },
      { href: `${home}#schedule`, label: es ? 'Horario de Clases' : 'Class Schedule' },
      { href: `${home}#pricing`, label: t('nav.pricing') },
      { href: `${home}#fighters`, label: es ? 'Programa de Competidores' : 'Fighters Program' },
      { href: `${home}#coaches`, label: es ? 'Nuestros Entrenadores' : 'Our Coaches' },
    ],
  },
  {
    title: es ? 'El Gimnasio' : 'Gym',
    links: [
      { href: route('about', lang), label: es ? 'Sobre Nosotros' : 'About Us' },
      { href: route('gallery', lang), label: t('nav.gallery') },
      { href: route('blog', lang), label: t('nav.blog') },
      { href: route('faq', lang), label: es ? 'Preguntas Frecuentes' : 'FAQ' },
      { href: route('contact', lang), label: t('nav.contact') },
    ],
  },
];

const mapQuery = encodeURIComponent(
  `${site.address.street}, ${site.address.locality}, ${site.address.region} ${site.address.postalCode}`,
);
---

<footer class="ftr gridlines">
  <div class="wrap">
    <div class="ftr__top">
      <div class="ftr__brand">
        <Logo size={92} />
        <p class="ftr__tag">
          {
            es
              ? 'La casa del boxeo de verdad en Staten Island. Fundado por Ian Sampaga para servir, influir e inspirar a nuestra comunidad con entrenamiento de primer nivel.'
              : 'Staten Island’s home for real boxing. Founded by Ian Sampaga to serve, influence and inspire our community through world-class training.'
          }
        </p>
        <a class="ftr__ig" href={site.social.instagram} rel="noopener" target="_blank">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"></circle>
          </svg>
          {site.social.instagramHandle}
        </a>
      </div>

      {
        cols.map((col) => (
          <nav class="ftr__col" aria-label={col.title}>
            <h2 class="ftr__ttl">{col.title}</h2>
            {col.links.map((l) => (
              <a href={l.href}>{l.label}</a>
            ))}
          </nav>
        ))
      }

      <div class="ftr__col ftr__col--visit">
        <h2 class="ftr__ttl">{t('footer.visit')}</h2>
        <a
          href={`https://www.google.com/maps/search/?api=1&query=${mapQuery}`}
          rel="noopener"
          target="_blank"
        >
          {site.address.street}<br />
          {site.address.locality}, {site.address.region} {site.address.postalCode}
        </a>
        {site.phone && <a href={`tel:${site.phone.replace(/[^0-9+]/g, '')}`}>{site.phone}</a>}
        <a href={`mailto:${site.email}`}>{t('footer.emailUs')}</a>

        <p class="ftr__es" lang="es">
          <span>{site.phoneEs.label}</span>
          <a href={`tel:${site.phoneEs.number.replace(/[^0-9+]/g, '')}`}>{site.phoneEs.number}</a>
        </p>
      </div>
    </div>

    <div class="ftr__bottom">
      <p class="ftr__legal">
        © {year} {site.legalName}. {t('footer.rights')}
        <span class="ftr__sep" aria-hidden="true">|</span>
        <a href={route('privacy', lang)}>{es ? 'Privacidad' : 'Privacy'}</a>
        <span class="ftr__sep" aria-hidden="true">|</span>
        <a href={route('terms', lang)}>{es ? 'Términos' : 'Terms'}</a>
        <span class="ftr__sep" aria-hidden="true">|</span>
        <a href="/sitemap-index.xml">{t('footer.sitemap')}</a>
        <span class="ftr__sep" aria-hidden="true">|</span>
        <a href="/llms.txt">llms.txt</a>
      </p>
      <p class="ftr__built">
        <a href={site.builtBy.url} rel="noopener" target="_blank">{site.builtBy.label}</a>
      </p>
    </div>
  </div>
</footer>

<style>
  /* Spanish line, marked lang="es" so screen readers switch pronunciation. */
  .ftr__es {
    margin-top: 0.35rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .ftr__es span {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ember-2);
  }

  .ftr {
    position: relative;
    border-top: 1px solid var(--line);
    background: linear-gradient(180deg, var(--ink-800), var(--ink-900));
    padding-block: clamp(3.5rem, 7vw, 6rem) 2rem;
    z-index: 2;
  }

  /*
   * On a phone this used to stack all four blocks in one column, which made the
   * footer 1242px tall on a 664px screen: nearly two full screens of footer to
   * scroll through after the page had ended.
   *
   * The two link columns are short lists, so they sit side by side from the
   * smallest screen up. That and a tighter gap cut roughly a third off the
   * mobile footer.
   */
  .ftr__top {
    display: grid;
    gap: 2rem clamp(1.5rem, 5vw, 4rem);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    position: relative;
  }

  /* The brand block keeps the full width above the two link columns. */
  /* The address block spans, it has the longest lines in the footer.
     NOT :last-of-type, which matches per element type and so was also hitting
     the last <nav> column and pushing it onto its own row. */
  .ftr__col--visit {
    grid-column: 1 / -1;
  }

  .ftr__brand {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: flex-start;
    max-width: 34ch;
  }

  .ftr__tag {
    font-size: var(--fs-sm);
    color: var(--chrome-3);
    line-height: 1.7;
  }

  .ftr__ig {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    color: var(--chrome-2);
    transition: color 0.3s var(--ease-out);
  }

  .ftr__ig:hover {
    color: var(--ember-2);
  }

  .ftr__col {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    align-items: flex-start;
  }

  .ftr__ttl {
    font-family: var(--font-mono);
    font-size: var(--fs-eyebrow);
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ember-2);
    margin-bottom: 0.35rem;
  }

  .ftr__col a {
    font-size: var(--fs-sm);
    color: var(--chrome-2);
    line-height: 1.6;
    transition:
      color 0.3s var(--ease-out),
      transform 0.3s var(--ease-out);
  }

  .ftr__col a:hover {
    color: var(--chrome);
    transform: translateX(3px);
  }

  .ftr__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    justify-content: space-between;
    align-items: center;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
    font-size: 0.8125rem;
    color: var(--chrome-3);
  }

  .ftr__legal a {
    color: var(--chrome-2);
    transition: color 0.3s var(--ease-out);
  }

  .ftr__legal a:hover {
    color: var(--ember-2);
  }

  .ftr__sep {
    margin-inline: 0.4rem;
    color: var(--chrome-3);
    opacity: 0.6;
  }

  .ftr__built {
    font-family: var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: 0.6875rem;
  }

  .ftr__built a {
    transition: color 0.3s var(--ease-out);
  }

  .ftr__built a:hover {
    color: var(--ember-2);
  }

  @media (min-width: 700px) {
    .ftr__top {
      gap: clamp(2.5rem, 5vw, 4rem);
    }

    .ftr__col--visit {
      grid-column: auto;
    }
  }

  @media (min-width: 1000px) {
    .ftr__top {
      grid-template-columns: 1.6fr 1fr 1fr 1.2fr;
    }

    .ftr__brand {
      grid-column: auto;
    }
  }
</style>
