---
import { getCollection } from 'astro:content';
import { path, type Lang } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang?: Lang;
  /** How many cards to show. Three fills the row at every breakpoint. */
  count?: number;
}
const { lang = 'en', count = 3 } = Astro.props;
const t = useTranslations(lang);

/**
 * The three newest posts, on the homepage.
 *
 * Reads the same collection the blog index does, so a new post appears here the
 * moment it is published. There is no curated list to keep in sync, which is the
 * whole point: a hand-picked "featured" array on the homepage is a thing that
 * silently goes stale.
 *
 * Renders nothing at all when the collection is empty. The Spanish blog has
 * fewer posts than the English one, and a section header with no cards under it
 * looks broken.
 */
const collection = lang === 'es' ? 'blog-es' : 'blog';
const blogBase = lang === 'es' ? '/es/blog/' : '/blog/';

const posts = (await getCollection(collection, ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, count);

const fmt = (d: Date) =>
  d.toLocaleDateString(lang === 'es' ? 'es-US' : 'en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
---

{
  posts.length > 0 && (
    <section class="section latest">
      <div class="wrap">
        <div class="section-head latest__head" data-reveal>
          <div>
            <p class="eyebrow">{t('latest.eyebrow')}</p>
            <h2 class="h2 steel">{t('latest.title')}</h2>
            <p class="lede latest__lede">{t('latest.lede')}</p>
          </div>
          <a class="latest__all" href={path('blog', lang)}>
            {t('latest.all')} →
          </a>
        </div>

        <div class="latest__grid">
          {posts.map((post, i) => (
            <a
              class="lpost card"
              href={`${blogBase}${post.id}/`}
              data-reveal
              data-reveal-index={i}
            >
              <div class="lpost__media">
                <img
                  src={post.data.image}
                  alt={post.data.imageAlt}
                  width="800"
                  height="500"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="lpost__body">
                <p class="lpost__meta">
                  {post.data.tags[0] && <span class="lpost__tag">{post.data.tags[0]}</span>}
                  <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
                </p>
                <h3 class="h3 lpost__ttl">{post.data.title}</h3>
                <p class="lpost__desc">{post.data.description}</p>
                <span class="lpost__more">{t('latest.more')} →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .latest {
    background: var(--ink-900);
    position: relative;
    z-index: 2;
  }

  /* .section-head is capped at 70ch so its copy stays readable. This one also
     carries the "all posts" link on the right, so the cap has to come off or the
     link lands in the middle of the page. */
  .latest__head {
    display: grid;
    max-width: none;
    gap: 1.25rem;
    align-items: end;
  }

  .latest__lede {
    max-width: 52ch;
    margin-top: 0.75rem;
  }

  .latest__all {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ember-2);
    white-space: nowrap;
    transition: transform 0.4s var(--ease-out);
    justify-self: start;
  }

  .latest__all:hover {
    transform: translateX(4px);
  }

  .latest__grid {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .lpost {
    display: flex;
    flex-direction: column;
    /* .card pads its contents; these cards run the image to the edge instead. */
    padding: 0;
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    background: linear-gradient(180deg, var(--ink-700), var(--ink-800));
    transition:
      transform 0.5s var(--ease-out),
      border-color 0.5s var(--ease-out);
  }

  .lpost:hover {
    transform: translateY(-4px);
    border-color: var(--line-strong);
  }

  /* Fixed ratio on the box, cover on the image. Post images are whatever shape
     the coach's phone produced, and the cards have to line up regardless. */
  .lpost__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--ink-600);
  }

  .lpost__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    transition:
      transform 0.8s var(--ease-out),
      filter 0.6s var(--ease-out);
  }

  .lpost:hover .lpost__media img {
    transform: scale(1.05);
    filter: grayscale(0) contrast(1);
  }

  .lpost__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.7rem;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    flex: 1;
  }

  .lpost__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    min-height: 1.55rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--chrome-3);
  }

  .lpost__tag {
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--ember-2);
  }

  .lpost__ttl {
    font-size: 1.1875rem;
    line-height: 1.3;
    color: var(--chrome);
  }

  .lpost__desc {
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--chrome-3);
    /* Three lines, so cards of very different description lengths still align. */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .lpost__more {
    margin-top: auto;
    padding-top: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ember-2);
    transition: transform 0.4s var(--ease-out);
  }

  .lpost:hover .lpost__more {
    transform: translateX(4px);
  }

  @media (min-width: 640px) {
    .latest__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 980px) {
    .latest__head {
      grid-template-columns: 1fr auto;
    }

    .latest__all {
      justify-self: end;
    }

    .latest__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
