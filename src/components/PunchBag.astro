---
/**
 * Interactive heavy bag. Click, tap, or hit Space/Enter to punch it.
 *
 * The swing is a damped pendulum integrated in requestAnimationFrame and
 * applied as a single `rotate()` on one group — no layout, no paint, so it
 * stays smooth on a phone. Impact bursts are short-lived absolutely-positioned
 * elements that remove themselves on animationend.
 *
 * The bag is a <button> so it is keyboard operable and announced properly;
 * the counter is aria-live="off" because narrating every punch would be
 * unbearable on a screen reader.
 */
---

<section class="section bag" id="bag-game">
  <div class="wrap bag__inner">
    <div class="bag__copy" data-reveal>
      <p class="eyebrow">Warm Up</p>
      <h2 class="h2 steel">Go on.<br />Hit it.</h2>
      <p class="lede">
        No wraps needed for this one. Click the bag — or tap it if you’re on
        your phone. It’s the only round at Ironhand you can do in jeans.
      </p>

      <dl class="bag__stats">
        <div class="bag__stat">
          <dt>Punches</dt>
          <dd><span data-bag-count aria-live="off">0</span></dd>
        </div>
        <div class="bag__stat">
          <dt>Best combo</dt>
          <dd><span data-bag-combo aria-live="off">0</span></dd>
        </div>
        <div class="bag__stat bag__stat--record">
          <dt>Personal best</dt>
          <dd><span data-bag-best aria-live="off">0</span></dd>
        </div>
        <div class="bag__stat bag__stat--wide">
          <dt>Power</dt>
          <dd>
            <span class="bag__meter"><i data-bag-power></i></span>
          </dd>
        </div>
      </dl>

      <p class="bag__msg" data-bag-msg aria-live="polite">Take a swing.</p>

      <a class="btn bag__cta" href="/contact-us/">Try the real thing</a>
    </div>

    <div class="bag__stage" data-reveal data-reveal-index="1">
      <button class="bag__hit" data-bag-hit aria-label="Punch the heavy bag">
        <svg class="bag__svg" viewBox="0 0 200 440" aria-hidden="true">
          <defs>
            <linearGradient id="bagLeather" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%" stop-color="#0d0f12"></stop>
              <stop offset="32%" stop-color="#2b3138"></stop>
              <stop offset="55%" stop-color="#3a424b"></stop>
              <stop offset="100%" stop-color="#111419"></stop>
            </linearGradient>
            <linearGradient id="bagStrap" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%" stop-color="#1a1e23"></stop>
              <stop offset="50%" stop-color="#454e58"></stop>
              <stop offset="100%" stop-color="#1a1e23"></stop>
            </linearGradient>
          </defs>

          <!-- Ceiling mount, stays put -->
          <rect x="66" y="0" width="68" height="12" rx="4" fill="#454e58"></rect>

          <!-- Everything below swings from the mount -->
          <g class="bag__swing">
            <!-- Chain, echoing the badge -->
            <g fill="none" stroke="#5b6470" stroke-width="5">
              <ellipse cx="100" cy="22" rx="7" ry="12"></ellipse>
              <ellipse cx="100" cy="40" rx="12" ry="7"></ellipse>
              <ellipse cx="100" cy="58" rx="7" ry="12"></ellipse>
              <ellipse cx="100" cy="76" rx="12" ry="7"></ellipse>
            </g>

            <!-- Top straps -->
            <path d="M74 96 L96 76 h8 l22 20 z" fill="url(#bagStrap)"></path>

            <!-- Body -->
            <path
              d="M62 96 h76 c7 0 12 5 12 12 v212 c0 28-22 48-50 48 s-50-20-50-48 V108 c0-7 5-12 12-12 z"
              fill="url(#bagLeather)"
              stroke="#5b6470"
              stroke-width="2"></path>

            <!-- Seams -->
            <g stroke="#0a0c0f" stroke-width="2" opacity="0.7">
              <path d="M52 150 h96"></path>
              <path d="M52 232 h96"></path>
              <path d="M52 314 h96"></path>
            </g>

            <!-- Specular highlight -->
            <path
              d="M74 104 c-4 60 -4 180 0 250"
              stroke="rgba(255,255,255,.16)"
              stroke-width="9"
              fill="none"
              stroke-linecap="round"></path>
          </g>
        </svg>

        <span class="bag__hint" data-bag-hint>Punch me</span>
      </button>

      <div class="bag__shadow" aria-hidden="true"></div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('#bag-game');
  if (root) {
    const hit = root.querySelector<HTMLButtonElement>('[data-bag-hit]')!;
    const swing = root.querySelector<SVGGElement>('.bag__swing')!;
    const countEl = root.querySelector<HTMLElement>('[data-bag-count]')!;
    const comboEl = root.querySelector<HTMLElement>('[data-bag-combo]')!;
    const powerEl = root.querySelector<HTMLElement>('[data-bag-power]')!;
    const bestEl = root.querySelector<HTMLElement>('[data-bag-best]')!;
    const msgEl = root.querySelector<HTMLElement>('[data-bag-msg]')!;
    const hintEl = root.querySelector<HTMLElement>('[data-bag-hint]')!;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let angle = 0;
    let vel = 0;
    let raf = 0;

    let count = 0;
    let combo = 0;
    let bestCombo = 0;
    let lastPunch = 0;
    let power = 0;

    // Declared before readBest() uses it. A `const` below its first call sits
    // in the temporal dead zone, and the guard below would quietly swallow the
    // resulting ReferenceError and report "no saved record".
    const BEST_KEY = 'ironhand:bag-best';

    // Personal best survives reloads. localStorage can throw in private mode
    // or when storage is blocked, so every access is guarded — a failure here
    // must not take the whole game down.
    const readBest = (): number => {
      try {
        return Number(localStorage.getItem(BEST_KEY)) || 0;
      } catch {
        return 0;
      }
    };
    const writeBest = (n: number) => {
      try {
        localStorage.setItem(BEST_KEY, String(n));
      } catch {
        /* storage unavailable — the run still counts, it just won't persist */
      }
    };

    /**
     * The record carried in from previous visits, captured once at load.
     * The celebration compares against THIS, not against `best` — `best`
     * tracks the live count, so comparing to it would fire on every punch.
     */
    const storedRecord = readBest();
    let best = storedRecord;
    bestEl.textContent = String(best);
    const recordTile = bestEl.closest('.bag__stat') as HTMLElement;

    /**
     * Exact-hit callouts. These fire once, on the punch that lands the number,
     * and outrank the running commentary below.
     */
    const EASTER_EGGS: Record<number, string> = {
      69: 'Nice.',
      100: 'Triple digits. The bag is filing a complaint.',
      111: 'Three jabs. Nothing but ones.',
      123: 'One. Two. Three. Easy.',
      187: 'Somebody call a corner man.',
      222: 'Double double double. Showoff.',
      250: 'You have punched more than some of our members. Genuinely.',
      300: 'This is Sparta. Also: go outside.',
      404: 'Punch not found. Somehow still counting.',
      500: 'Five hundred. Ian would like a word.',
      666: 'Demonic hand speed.',
      777: 'Jackpot. The bag pays out in bruises.',
      911: 'Okay, seriously, are you alright?',
      1000: 'One thousand. You win. There is nothing else. Go book a class.',
    };

    /** Running commentary — highest threshold at or below the count wins. */
    const MESSAGES: [number, string][] = [
      [750, 'We have stopped keeping track. You have not.'],
      [400, 'The bag has left the building.'],
      [150, 'Holy S#!T you’re still going?'],
      [120, 'Your mouse has a stress injury.'],
      [80, 'Eighty. Okay, you’ve got something.'],
      [50, 'Fifty. Hands are getting fast.'],
      [25, 'Twenty-five. Now keep your guard up.'],
      [10, 'Ten in. Feeling it yet?'],
      [1, 'That’s one. Keep going.'],
    ];

    /** Damped pendulum — spring back to centre, bleed energy each frame. */
    function tick() {
      vel += -angle * 0.014;
      vel *= 0.975;
      angle += vel;

      // Bleed the power meter back down when idle
      power = Math.max(0, power - 0.9);
      powerEl.style.width = power + '%';

      swing.style.transform = `rotate(${angle.toFixed(3)}deg)`;

      if (Math.abs(angle) > 0.02 || Math.abs(vel) > 0.02 || power > 0) {
        raf = requestAnimationFrame(tick);
      } else {
        angle = 0;
        vel = 0;
        swing.style.transform = '';
        raf = 0;
      }
    }

    function burst(x: number, y: number) {
      if (reduced) return;
      const el = document.createElement('span');
      el.className = 'bag__burst';
      el.style.left = x + 'px';
      el.style.top = y + 'px';
      hit.appendChild(el);
      el.addEventListener('animationend', () => el.remove(), { once: true });
    }

    function punch(clientX?: number, clientY?: number) {
      const rect = hit.getBoundingClientRect();
      const x = clientX ?? rect.left + rect.width / 2;
      const y = clientY ?? rect.top + rect.height / 2;

      // Punch from the left pushes it right, and vice versa.
      const offset = (x - (rect.left + rect.width / 2)) / (rect.width / 2);
      const impulse = (offset >= 0 ? -1 : 1) * (1.1 + Math.abs(offset) * 1.3);

      vel += impulse;
      vel = Math.max(-4.5, Math.min(4.5, vel)); // keep it from going full windmill

      burst(x - rect.left, y - rect.top);

      const now = performance.now();
      combo = now - lastPunch < 900 ? combo + 1 : 1;
      lastPunch = now;
      bestCombo = Math.max(bestCombo, combo);
      count++;

      power = Math.min(100, power + 9 + combo * 1.5);

      countEl.textContent = String(count);
      comboEl.textContent = String(bestCombo);
      powerEl.style.width = power + '%';

      // Fires on exactly the punch that passes the record you arrived with.
      const beatIt = storedRecord > 0 && count === storedRecord + 1;
      if (count > best) {
        best = count;
        bestEl.textContent = String(best);
        writeBest(best);
      }

      // Message priority: beating your record > exact-number callout > the
      // running commentary. Whichever wins, the physics below still run.
      let celebrate = false;
      if (beatIt) {
        msgEl.textContent = 'New personal best.';
        recordTile.classList.remove('is-new');
        void recordTile.offsetWidth;
        recordTile.classList.add('is-new');
        celebrate = true;
      } else if (EASTER_EGGS[count]) {
        msgEl.textContent = EASTER_EGGS[count];
        celebrate = true;
      } else {
        const msg = MESSAGES.find(([n]) => count >= n);
        if (msg) msgEl.textContent = msg[1];
      }

      if (celebrate) {
        msgEl.classList.remove('is-pop');
        void msgEl.offsetWidth;
        msgEl.classList.add('is-pop');
      }

      hintEl.classList.add('is-gone');
      hit.classList.remove('is-hit');
      // Force reflow so the impact animation restarts on rapid punches
      void hit.offsetWidth;
      hit.classList.add('is-hit');

      if (!raf) raf = requestAnimationFrame(tick);
    }

    hit.addEventListener('pointerdown', (e) => punch(e.clientX, e.clientY));

    // Space/Enter fire click; ignore it when it came from a pointer so a mouse
    // press doesn't register twice.
    hit.addEventListener('click', (e) => {
      if (e.detail === 0) punch();
    });

    // Stop the page scrolling when the bag is tapped and held on mobile
    hit.addEventListener('touchstart', (e) => e.preventDefault(), { passive: false });
  }
</script>

<style>
  .bag {
    position: relative;
    z-index: 2;
    background: linear-gradient(180deg, var(--ink-900), var(--ink-800));
    overflow: hidden;
  }

  .bag__inner {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .bag__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.2rem;
  }

  /* ---- Stats ---- */
  .bag__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    width: 100%;
    max-width: 30rem;
    margin: 0.5rem 0 0;
  }

  .bag__stat {
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.03);
  }

  .bag__stat--wide {
    grid-column: 1 / -1;
  }

  .bag__stat dt {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--chrome-3);
  }

  .bag__stat dd {
    margin: 0.35rem 0 0;
    font-family: var(--font-display);
    font-size: 1.75rem;
    line-height: 1;
    color: var(--chrome);
    font-variant-numeric: tabular-nums;
  }

  .bag__meter {
    display: block;
    height: 10px;
    margin-top: 0.55rem;
    border-radius: 100px;
    background: rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }

  .bag__meter i {
    display: block;
    height: 100%;
    width: 0;
    border-radius: 100px;
    background: var(--grad-ember);
    transition: width 0.12s linear;
  }

  .bag__stat--record dd {
    color: var(--gold);
  }

  /* Gold flash when the record falls */
  .bag__stat--record.is-new {
    animation: record 1s var(--ease-out);
  }

  @keyframes record {
    0% {
      border-color: var(--gold);
      background: rgba(212, 175, 55, 0.22);
      transform: scale(1.03);
    }
    100% {
      border-color: var(--line);
      background: rgba(255, 255, 255, 0.03);
      transform: scale(1);
    }
  }

  .bag__msg {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ember-2);
    min-height: 1.2em;
  }

  /* Milestone lines land with a small kick so they read as an event */
  .bag__msg.is-pop {
    animation: msgPop 0.55s var(--ease-punch);
  }

  @keyframes msgPop {
    0% {
      transform: scale(0.9);
      opacity: 0.3;
      color: var(--gold);
    }
    60% {
      transform: scale(1.06);
      color: var(--gold);
    }
    100% {
      transform: scale(1);
      opacity: 1;
      color: var(--ember-2);
    }
  }

  .bag__cta {
    margin-top: 0.35rem;
  }

  /* ---- Stage ---- */
  .bag__stage {
    position: relative;
    display: grid;
    place-items: center;
    justify-self: center;
    width: 100%;
  }

  .bag__hit {
    position: relative;
    display: block;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    /* Stops mobile browsers hijacking taps as double-tap-to-zoom */
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
  }

  /* Sized by HEIGHT, not width. The bag is 200x440, so constraining width
     makes it disproportionately tall on a phone and pushes the counter off
     screen — you need to see the stats while you punch. */
  .bag__svg {
    height: clamp(240px, 34vh, 380px);
    width: auto;
    overflow: visible;
    filter: drop-shadow(0 30px 40px rgba(0, 0, 0, 0.55));
  }

  .bag__swing {
    /* Pivot at the ceiling mount, in viewBox coordinates */
    transform-box: view-box;
    transform-origin: 100px 6px;
    will-change: transform;
  }

  /* Whole-rig recoil on impact, separate from the pendulum rotation */
  .bag__hit.is-hit .bag__svg {
    animation: recoil 0.28s var(--ease-out);
  }

  @keyframes recoil {
    0% {
      transform: scale(1);
    }
    30% {
      transform: scale(1.035, 0.965);
    }
    100% {
      transform: scale(1);
    }
  }

  .bag__hint {
    position: absolute;
    left: 50%;
    bottom: -0.5rem;
    translate: -50% 0;
    padding: 0.4rem 0.9rem;
    border-radius: 100px;
    background: var(--grad-ember);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #fff;
    white-space: nowrap;
    animation: nudge 2.2s ease-in-out infinite;
    transition: opacity 0.4s var(--ease-out);
  }

  .bag__hint.is-gone {
    opacity: 0;
    pointer-events: none;
    animation: none;
  }

  @keyframes nudge {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-5px);
    }
  }

  /* Impact burst, injected per punch */
  .bag__hit :global(.bag__burst) {
    position: absolute;
    width: 12px;
    height: 12px;
    margin: -6px 0 0 -6px;
    border: 2px solid var(--ember-2);
    border-radius: 50%;
    pointer-events: none;
    animation: burst 0.5s var(--ease-out) forwards;
  }

  @keyframes burst {
    from {
      transform: scale(0.4);
      opacity: 1;
    }
    to {
      transform: scale(7);
      opacity: 0;
    }
  }

  .bag__shadow {
    width: min(40vw, 170px);
    height: 16px;
    margin-top: 0.4rem;
    border-radius: 50%;
    background: radial-gradient(ellipse, rgba(0, 0, 0, 0.6), transparent 70%);
    filter: blur(3px);
  }

  /* On phones the bag comes first so it and the counter share the screen —
     otherwise you punch blind with the stats scrolled out of view. */
  @media (max-width: 899px) {
    .bag__stage {
      order: -1;
      margin-bottom: 0.5rem;
    }
  }

  @media (min-width: 900px) {
    .bag__inner {
      grid-template-columns: 1.05fr 0.95fr;
    }

    .bag__svg {
      height: clamp(380px, 56vh, 600px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bag__hint,
    .bag__hit.is-hit .bag__svg,
    .bag__msg.is-pop,
    .bag__stat--record.is-new {
      animation: none;
    }
  }
</style>
